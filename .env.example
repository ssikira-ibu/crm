# Root .env — single source of truth for secrets across all services.
# Loaded by `docker compose` via ${...} interpolation and by `npm run dev`
# scripts via `--env-file=../.env`. Copy to `.env` and fill in real values.
# Per-service .env files (backend/.env, frontend/.env.local, agent/.env)
# hold only non-secret, service-specific config.

# ---------------------------------------------------------------------------
# Shared secrets (must match across services)
# ---------------------------------------------------------------------------

# HS256 secret used to sign service-to-service JWTs (frontend BFF → backend,
# agent → backend). At least 32 characters. Must be identical across all
# three services that mint or verify these tokens.
S2S_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# HS256 secret used to sign the frontend session cookie (Firebase ID token
# → HTTP-only session JWT). Frontend-only. At least 32 characters.
SESSION_SECRET=replace-with-a-different-long-random-string

# Path (inside the frontend container) to the Firebase Admin service account
# JSON used to verify Firebase ID tokens. The file is bind-mounted from
# ./firebase-service-account.json at the repo root.
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# ---------------------------------------------------------------------------
# Agent service
# ---------------------------------------------------------------------------

# Anthropic API key for the agent's LLM calls.
ANTHROPIC_API_KEY=sk-ant-...
