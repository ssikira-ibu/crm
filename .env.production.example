# Domain (for CORS allowlist)
DOMAIN=crm.ssikira.com

# Cloudflare Tunnel token (from Zero Trust dashboard)
TUNNEL_TOKEN=

# GHCR images (set by CI, or manually for first deploy)
IMAGE_PREFIX=ghcr.io/OWNER/REPO
IMAGE_TAG=latest

# PostgreSQL (generate with: openssl rand -base64 32)
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_DB=crm

# Auth secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=
S2S_JWT_SECRET=

# Firebase (client-side config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Agent service (Anthropic API)
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# Firebase Admin SDK
# Paste the full service account JSON as a single line (use `jq -c . key.json`).
# Wrap it in single quotes in the deployed .env file:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=
